[
  {
    "id": "github-deploy",
    "execute-command": "/opt/inventory/webhook/deploy-wrapper.sh",
    "command-working-directory": "/opt/inventory",
    "response-message": "ok",
    "http-methods": ["POST"],
    "pass-arguments-to-command": [
      {
        "source": "payload",
        "name": "ref"
      }
    ],
    "trigger-rule": {
      "and": [
        {
          "match": {
            "secret": "{{ getenv \"WEBHOOK_SECRET\" }}",
            "type": "payload-hmac-sha256",
            "parameter": {
              "source": "header",
              "name": "X-Hub-Signature-256"
            }
          }
        },
        {
          "match": {
            "type": "value",
            "value": "push",
            "parameter": {
              "source": "header",
              "name": "X-GitHub-Event"
            }
          }
        },
        {
          "match": {
            "type": "regex",
            "regex": "^refs/tags/v[0-9]+\\.[0-9]+\\.[0-9]+$",
            "parameter": {
              "source": "payload",
              "name": "ref"
            }
          }
        },
        {
          "match": {
            "type": "value",
            "value": "false",
            "parameter": {
              "source": "payload",
              "name": "deleted"
            }
          }
        }
      ]
    }
  }
]
